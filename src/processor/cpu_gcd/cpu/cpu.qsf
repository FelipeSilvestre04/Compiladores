# set_location_assignment PIN_AF22 -to switches[15]
# set_location_assignment PIN_AD22 -to switches[16]
# set_location_assignment PIN_AG25 -to switches[17]

# Mapeamento do clock: PIN_Y2 e o CLOCK_50 padrao da DE2-115.
# Se o laboratorio remoto ou ambiente exigir CLOCK2_50, utilize PIN_AG14.
set_location_assignment PIN_Y2 -to clk_50
# set_location_assignment PIN_AG14 -to clk_50
set_location_assignment PIN_G19 -to led_clock
set_location_assignment PIN_H15 -to switches_leds[5]
set_location_assignment PIN_G16 -to switches_leds[4]
set_location_assignment PIN_G15 -to switches_leds[3]
set_location_assignment PIN_F15 -to switches_leds[2]
set_location_assignment PIN_H17 -to switches_leds[1]
set_location_assignment PIN_J16 -to switches_leds[0]
set_location_assignment PIN_E19 -to in_sign_out

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top