// Módulo principal que controla os 8 displays de 7 segmentos.
module ControleSaida(
    input        enable,      // Ativa a exibição. Conectar ao io_write_enable da CPU.
    input [31:0] data_in,     // Dado a ser exibido. Conectar ao io_data_out da CPU.
    output [6:0] Hex0,        // Display menos significativo
    output [6:0] Hex1,
    output [6:0] Hex2,
    output [6:0] Hex3,
    output [6:0] Hex4,
    output [6:0] Hex5,
    output [6:0] Hex6,
    output [6:0] Hex7         // Display mais significativo
);

    // Fios para armazenar cada dígito decimal do número de entrada.
    wire [3:0] digit0, digit1, digit2, digit3, digit4, digit5, digit6, digit7;

    // Lógica para extrair cada dígito decimal do número binário de entrada.
    // Usamos divisão e módulo por potências de 10.
    assign digit0 = (data_in / 1) % 10;
    assign digit1 = (data_in / 10) % 10;
    assign digit2 = (data_in / 100) % 10;
    assign digit3 = (data_in / 1000) % 10;
    assign digit4 = (data_in / 10000) % 10;
    assign digit5 = (data_in / 100000) % 10;
    assign digit6 = (data_in / 1000000) % 10;
    assign digit7 = (data_in / 10000000) % 10;
    
    // Fios para os sinais decodificados dos displays.
    wire [6:0] s0, s1, s2, s3, s4, s5, s6, s7;

    // Instancia um decodificador para cada um dos 8 dígitos.
    Decode7seg D0 (.entrada(digit0), .saida(s0));
    Decode7seg D1 (.entrada(digit1), .saida(s1));
    Decode7seg D2 (.entrada(digit2), .saida(s2));
    Decode7seg D3 (.entrada(digit3), .saida(s3));
    Decode7seg D4 (.entrada(digit4), .saida(s4));
    Decode7seg D5 (.entrada(digit5), .saida(s5));
    Decode7seg D6 (.entrada(digit6), .saida(s6));
    Decode7seg D7 (.entrada(digit7), .saida(s7));

    // Lógica para apagar os displays se a entrada 'enable' estiver desativada.
    // Também apaga os zeros à esquerda para uma exibição mais limpa.
    assign Hex0 = enable                               ? s0 : 7'b1111111;
    assign Hex1 = (enable && data_in >= 10)            ? s1 : 7'b1111111;
    assign Hex2 = (enable && data_in >= 100)           ? s2 : 7'b1111111;
    assign Hex3 = (enable && data_in >= 1000)          ? s3 : 7'b1111111;
    assign Hex4 = (enable && data_in >= 10000)         ? s4 : 7'b1111111;
    assign Hex5 = (enable && data_in >= 100000)        ? s5 : 7'b1111111;
    assign Hex6 = (enable && data_in >= 1000000)       ? s6 : 7'b1111111;
    assign Hex7 = (enable && data_in >= 10000000)      ? s7 : 7'b1111111;

endmodule