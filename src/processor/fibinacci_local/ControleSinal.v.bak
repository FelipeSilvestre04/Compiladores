module ControleSinal(in, btn, saida);
	input in, btn;
	output wire saida;
	
	reg EstadoAtual;
	always @(posedge btn or negedge in) // Sensível à subida do botão OU à descida do sinal 'in'
	begin
		if(!in) begin
			EstadoAtual <= 0; // Se 'in' cair para 0, reseta o estado
		end
		else begin 
			EstadoAtual <= 1; // Se o botão for pressionado (enquanto 'in' está em 1)
		end
	end
	
	assign saida = EstadoAtual;
endmodule