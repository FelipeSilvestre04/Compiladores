@startuml
title Diagrama de Blocos - Fase de Sintese do Compilador

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #404040
skinparam component {
  BorderColor #404040
  BackgroundColor #F7F7F7
}
skinparam database {
  BorderColor #404040
  BackgroundColor #FFFFFF
}

rectangle "AST validada\nast.h" as AST
component "Geracao de Quadruplas\nprocessa_arvore()\ngerador_quaduplas.c" as QUADGEN
database "Estruturas Internas\nprogram[], labels[], variables[]\ngerador_quaduplas.c" as MAPS
artifact "saida.quad" as QUAD
component "Traducao para Assembly\nsalvar_asm_line()\ngerador_quaduplas.c" as ASMGEN
artifact "saida.asm" as ASM
component "Codificacao Binaria\nwrite_binary_instruction()\ngerador_quaduplas.c" as BINGEN
artifact "programa.txt" as BIN
rectangle "ROM do Processador\nrom.v" as ROM

AST --> QUADGEN : percurso da arvore
QUADGEN --> QUAD : codigo intermediario
QUAD --> ASMGEN : operacoes intermediarias
ASMGEN --> ASM : instrucoes assembly
ASM --> BINGEN : mnemonicos e operandos
BINGEN --> BIN : palavras de 32 bits
BIN --> ROM : carga do programa

QUADGEN <--> MAPS : temporarios,\nenderecos e escopos
ASMGEN <--> MAPS : rotulos e instrucoes
BINGEN <--> MAPS : labels e PCs

@enduml
