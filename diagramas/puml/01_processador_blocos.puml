@startuml
title Diagrama de Blocos - Processador

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #404040
skinparam component {
  BorderColor #404040
  BackgroundColor #F7F7F7
}
skinparam rectangle {
  BorderColor #404040
  BackgroundColor #FFFFFF
}

rectangle "Busca e Decodificacao" {
  rectangle "PC\nPC.v" as PC
  rectangle "ROM de Instrucoes\nrom.v / programa.txt" as ROM
  rectangle "Decodificador\ndecoder_instrucao.v" as DEC
}

rectangle "Controle" {
  rectangle "Unidade de Controle\nUnidade_Controle.v" as UC
  rectangle "Controle de PC\nbranch / jump / jr / jal" as CTRLPC
}

rectangle "Caminho de Dados" {
  rectangle "Banco de Registradores\nbanco.v" as REG
  rectangle "MUX da ULA\nmux_ula.v" as MUXULA
  rectangle "ULA\nula.v" as ULA
  rectangle "Memoria de Dados\nram.v" as RAM
  rectangle "MUX de Escrita\nmux_memoria.v" as MUXMEM
  rectangle "Pilha / SP\ncpu.v + ram.v" as STACK
  rectangle "Entrada e Saida\nControleSinal.v / ControleSaida.v" as IO
}

PC -down-> ROM : endereco
ROM -down-> DEC : instrucao
DEC -right-> UC : opcode e funct
DEC -down-> REG : rs1, rs2 e rd

UC -down-> REG : RegWrite
UC -down-> MUXULA : ALUSrc / ALUop
UC -right-> CTRLPC : Jump / Branch / Halt
CTRLPC -up-> PC : proximo PC

REG -down-> MUXULA : rs2
MUXULA -right-> ULA : operando
REG -right-> ULA : rs1
ULA -right-> MUXMEM : resultado
MUXMEM -up-> REG : dado escrito

ULA -down-> RAM : endereco
RAM -up-> MUXMEM : dado lido
REG -down-> RAM : dado de STORE
RAM -down-> STACK : push / pop
REG -down-> IO : IN / OUT

@enduml
